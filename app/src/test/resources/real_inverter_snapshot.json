":"kWh","warningCount":0,"timeZone":"UTC-05:00","batHighVolFlag":false,"batPackageList":null,"feedPower":null,"type":"337","subType":"1039","opType":65534,"opTypeStr":"-","parentId":"0","operator":null,"groupFlag":null,"gridInputPower":null,"loadPower":null,"pvPowerUnit":null,"electricityMeterLink":0,"batTy":null,"batTyStr":"-","operM":"1","operMStr":"Null Export zum Laden","operMHelpInfo":"Verkauf zuerst:\nDieser Modus ermöglicht es einem hybriden Wechselrichter, überschüssige Energie, die von den Solarpaneelen erzeugt wird, an das Stromnetz zurückzugeben. Wenn \"Zeitabhängige Tarife\" aktiv sind, kann auch die Batterieenergie an das Netz verkauft werden.\nDie PV-Energie wird verwendet, um die Belastung zu versorgen und die Batterie zu laden. Überschüssige Energie fließt dann ins Netz.\nDie Priorität der Energiequelle für die Belastung ist wie folgt:\n1.Solarpaneelen.\n2.Stromnetz, wenn die Energieeinstellung auf \"Batterie zuerst\" gesetzt ist.\nBatterie (bis zum einstellbaren Entladungssollwert), wenn die Energieeinstellung auf \"Last zuerst\" gesetzt ist und das Netz-Laden deaktiviert ist.\nNull-Export an die Last:\nDer hybride Wechselrichter versorgt nur die angeschlossene Reserve-Last mit Strom. Der hybride Wechselrichter versorgt weder die Haushaltslast noch verkauft er Strom an das Netz. Der integrierte CT erkennt Stromfluss zurück ins Netz und reduziert die Leistung des Wechselrichters, um nur die Reserve-Last zu versorgen und die Batterie zu laden.\nNull-Export an den CT:\nDer hybride Wechselrichter versorgt nicht nur die angeschlossene Reserve-Last, sondern auch die angeschlossene Haushaltslast mit Strom. Wenn die PV-Leistung und die Batterie-Leistung unzureichend sind, wird das Netz als Ergänzung herangezogen. Der hybride Wechselrichter verkauft keinen Strom an das Netz. In diesem Modus ist ein CT erforderlich. Bitte beziehen Sie sich auf das Handbuch 4.4-2 CT-Verbindung für die Installationsmethode des CT. Der externe CT erkennt den Stromfluss zurück ins Netz und reduziert die Leistung des Wechselrichters, um nur die Reserve-Last, die Batterie und die Haushaltslast zu versorgen.","ronoff":null,"ronoffStr":"-","model":"1","genMod":"0","gpoL":null,"gpunb":null,"stand":"3","buzEn":"0","bligEn":"0","isOwnerDevice":0,"ebatCharToday":"6.3","ebatDisCharToday":"8","oSPri":null,"oSPriStr":"-","cSPri":null,"cSPriStr":"-","mpptBA":null,"oL2Byp":null,"oLRst":null,"oTRst":null,"appMo":null,"outMod":null,"outModStr":"-","batMod":0,"estore":null,"deviceSettingJson":null,"bMChC":null,"bMDCu":null,"hasMaster":0,"hotJson":"{\"busPos\":0,\"busVn\":236.800,\"ctPowerL1\":0,\"ctPowerL2\":0,\"eGridInToday\":5.600,\"gridInTotal\":115.200,\"homeLoadPowerL1\":0,\"homeLoadPowerL2\":0,\"inverterACurr\":4.300,\"inverterACurrDcComponent\":-1,\"inverterAFreq\":59.990,\"inverterAPower\":509,\"inverterAVolt\":119.900,\"inverterAVoltDcComponent\":3,\"inverterBCurr\":8.500,\"inverterBCurrDcComponent\":-1,\"inverterBFreq\":59.990,\"inverterBPower\":987,\"inverterBVolt\":119.900,\"inverterBVoltDcComponent\":4,\"inverterCCurr\":0,\"inverterCCurrDcComponent\":-1,\"inverterCFreq\":59.990,\"inverterCPower\":0,\"inverterCVolt\":0,\"inverterCVoltDcComponent\":0,\"inverterTotalPower\":1496,\"lkCurr\":0,\"llcCu\":0,\"loadRPercent\":1300,\"loadSPercent\":2600,\"loadTPercent\":0,\"meterStatus\":0,\"parStatus\":0}","parStatus":0,"parStatusAnalysis":"Deaktivieren","ePvTotal":"94.9","eBatCharTotal":"90.6","eBatDisCharTotal":"76.3","eTotal":"115.2","eGridFeedTotal":"0","eLoadTotal":"176.9","eInvTotal":null,"lLoadTotal":"0","tLoadTotal":"176.9","pv1Total":"0","pv2Total":"94.9","pv3Total":"0","pv4Total":"0","bat1CharTotal":"90.6","bat1DisCharTotal":"76.3","bat2CharTotal":"0","bat2DisCharTotal":"0","genTotal":"0","smartLoadTotal":"0","eMicroTotal":null,"invSn":null,"conState":null,"meterPowerL1":"0","meterPowerL2":"0","meterPowerL3":null,"meterTotalPower":null,"gunState":null,"gunStateStr":"-","csWkState":null,"csWkStateStr":null,"acVoltageL1":null,"acVoltageL2":null